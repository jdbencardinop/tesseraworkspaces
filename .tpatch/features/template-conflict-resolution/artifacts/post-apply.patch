+			want := []byte("local\n")
+			if action == "edit" {
+				want = []byte("accepted edit\n")
+			}
+			if err := ResolveManagedTemplateConflict(plan, ManagedTemplateRoleWorktree, "shared.md", action, want); err != nil {
+				t.Fatal(err)
