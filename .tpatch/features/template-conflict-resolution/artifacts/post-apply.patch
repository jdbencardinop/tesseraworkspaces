+			}
+			if snapshotTree(t, path) != before {
+				t.Fatal("hard blocker changed custom files/metadata")
+			}
+		})
+	}
+}
+
+func TestNamedTemplateConflictBatchPartialFailureReportsFeatureAndRecovery(t *testing.T) {
