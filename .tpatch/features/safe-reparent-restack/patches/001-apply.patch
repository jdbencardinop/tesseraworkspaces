+				"if [ \"$1\" = \"prepared\" ]; then\n"+
+				"  while read -r old new ref; do\n"+
+				"    case \"$ref\" in refs/heads/pr3)\n"+
+				"      if [ ! -f "+flag+" ]; then : > "+flag+"; exit 1; fi;;\n"+
