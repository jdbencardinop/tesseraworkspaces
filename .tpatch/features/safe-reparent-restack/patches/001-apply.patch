+			}
+		})
+		if !strings.Contains(stderr, "reparent-remote: would refuse: "+string(internal.ReparentRefusalStateUnsupported)) {
+			t.Fatalf("the dry run must report the verdict as a diagnostic:\n%s", stderr)
