+	guard, err := ReadSyncRunGuard(loc.FeaturePath)
+	if err != nil || guard == nil {
+		reason := "the sync run guard does not decode"
+		if err != nil {
+			reason = err.Error()
+		}
+		out.Presence = "unreadable"
+		out.UnreadableReason = &reason
+		return out
