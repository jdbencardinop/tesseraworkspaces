+		args := append([]string{checkout.Feature, "pr2", "--onto", "main", "--plan", "--json"}, fetchArgs...)
+		var stdout string
+		var code int
+		_, _, log := reparentPushCapture(t, func() {
+			stdout, _, code = checkout.Run(args...)
