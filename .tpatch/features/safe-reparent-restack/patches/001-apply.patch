+			if after := f.reparentGit(f.Repo, "for-each-ref", "--format=%(refname) %(objectname)", "refs/"); after != refsBefore {
+				t.Fatalf("a preview moved a ref:\n--- before ---\n%s\n--- after ---\n%s", refsBefore, after)
