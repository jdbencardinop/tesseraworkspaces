+		Entries: []ReparentRemoteEntry{{
+			Name: "pr9", GitBranch: "pr9", Remote: ReparentRemoteName,
+			RemoteRef: "refs/remotes/origin/pr9", NewTipSHA: w.Repo.RevParse("pr9"),
+			RemoteSHAAtWrite: main, State: ReparentRemoteStatePending,
+		}},
