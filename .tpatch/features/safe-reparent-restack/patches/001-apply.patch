+				} else {
+					var refusal *ReparentRefusalError
+					if !errors.As(err, &refusal) || refusal.Kind != ReparentRefusalStateCorrupt {
+						t.Fatalf("continue refusal = %v", err)
+					}
+				}
+				if len(*log) != 0 {
+					t.Fatalf("corrupt state spawned Git: %v", *log)
