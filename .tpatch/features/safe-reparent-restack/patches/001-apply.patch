+			t.Fatalf("validation = %+v, want state-preserved validation-failed", err)
+		}
+		gitInTest(t, run.State.ScratchPath, "switch", "--detach", run.State.Row("pr2").PlannedNewSHA)
+		if _, err := AbortReparent(in); err != nil {
+			t.Fatal(err)
+		}
+	}(t)
+}
