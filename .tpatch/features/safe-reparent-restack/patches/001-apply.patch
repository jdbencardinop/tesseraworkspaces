+		Strategy:                   ReparentStateStrategy,
+		Backend:                    ReparentStateBackend,
+		Stage:                      ReparentStageInitializing,
+		ResumeStage:                ReparentStageInitializing,
+		OwnerPID:                   os.Getpid(),
+		OwnerToken:                 strings.Repeat("b", 32),
+		TargetName:                 "pr2",
