+	writeTransactionalLoadYAML(t, CheckoutTransactionPath(featurePath), ReparentCheckoutCompatTransaction{
+		StateVersion:   ReparentCheckoutCompatStateVersion,
+		Route:          ReparentCompatRoute,
+		Feature:        "feature",
