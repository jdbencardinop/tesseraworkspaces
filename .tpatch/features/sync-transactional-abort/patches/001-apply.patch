+				case "payload-after-claim":
+					evidencePath, evidenceBytes = internal.SyncRunStatePath(f.featurePath), orphan
+				case "stack-before-fallback":
+					evidencePath, evidenceBytes = internal.StackPath(f.featurePath), stack
+				}
