+	if _, _, err := runManagedCobra(t, newCmd(), []string{
+		"branchless", "owner-probe", "--base", "main",
+	}, nil); err == nil || !strings.Contains(err.Error(), "belongs to repository") {
+		t.Fatalf("unrelated repository was accepted as managed owner: %v", err)
+	}
