+func ReplanManagedTemplate(plan *ManagedTemplatePlan) (*ManagedTemplatePlan, error) {
+	if plan == nil {
+		return nil, errors.New("managed template plan is nil")
+	}
+	return PlanManagedTemplate(plan.Request)
+}
