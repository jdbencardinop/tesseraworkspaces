+	if !sameResolvedRepoRoot(targetRepo, actualRepo) {
+		return "", fmt.Errorf("stack entry %q records repository %s but its worktree belongs to %s",
+			entry.Name, targetRepo, actualRepo)
+	}
+	return targetRepo, nil
