+	}
+	source := managedCLIPackage(t, filepath.Join(f.root, "source-"+name+"-"+strings.ReplaceAll(files["inject/shared.md"], "\n", "_")), files, "")
+	if err := internal.AddNamedTemplate("", internal.TemplateScopeGlobal, name, source); err != nil {
