+func forkChild(t *testing.T, dir, child, base string, commits int) {
+	t.Helper()
+	original := gitInTest(t, dir, "rev-parse", "--abbrev-ref", "HEAD")
+	gitInTest(t, dir, "checkout", "-b", child, base)
+	for i := 0; i < commits; i++ {
