+	cfg := LoadConfig()
+	fp := ws.FeaturePath("myfeat")
+	stack, err := LoadStack(fp)
+	if err != nil {
+		t.Fatal(err)
+	}
+	edges, _ := FeatureStackEdges(ws, cfg, "myfeat", fp, stack)
+
+	report, err := BuildCheckoutHealthReport(ws, &CheckoutHealthOpts{Proc: fakeProcessChecker{}, Tmux: fakeTmuxChecker{}})
+	if err != nil {
