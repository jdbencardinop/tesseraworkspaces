+			remote := filepath.Join(f.root, "primary.git")
+			beforeRemote := syncSnapshotRefs(t, remote)
+			for _, command := range []struct {
+				cmd  *cobra.Command
+				args []string
+			}{
+				{pushCmd(), []string{"old", "--dry-run"}},
+				{pushCmd(), []string{"old"}},
+				{syncCmd(), []string{"old", "--no-fetch", "--local-only"}},
+				{syncCmd(), []string{"old", "--plan", "--no-fetch"}},
