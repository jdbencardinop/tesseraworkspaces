+func TestFeatureRenameAdmissionJoinsConcurrentLockCreator(t *testing.T) {
+	for _, winnerKind := range []string{"regular", "fifo", "symlink"} {
+		t.Run(winnerKind, func(t *testing.T) {
+			path := t.TempDir()
+			parent, err := os.Open(path)
+			if err != nil {
