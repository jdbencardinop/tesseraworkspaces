+
+	// Advance main
+	gitRunCS(t, dir, "checkout", "main")
+	writeFileCS(t, dir, "new.txt", "new\n")
+	gitRunCS(t, dir, "add", ".")
+	gitRunCS(t, dir, "commit", "-m", "advance main")
+
+	// Back to child
+	gitRunCS(t, dir, "checkout", "child")
