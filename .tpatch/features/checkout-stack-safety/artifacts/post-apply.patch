+	saveTestStack(t, fp, []internal.StackEntry{
+		{Name: "child", Base: "main"},
+	})
+
+	opts := internal.CheckoutSyncOpts{
+		Feature:     "test-feature",
+		FeaturePath: fp,
+		RepoDir:     dir,
+	}
+
+	if err := internal.RunCheckoutSync(opts); err != nil {
+		t.Fatalf("sync failed: %v", err)
