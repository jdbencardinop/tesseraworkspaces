+// goldenPkgDir is the package directory captured at init, before any fixture
+// chdirs. Golden paths must not follow the working directory into a fixture.
+var goldenPkgDir = func() string {
+	dir, err := os.Getwd()
+	if err != nil {
+		return "."
+	}
+	return dir
+}()
