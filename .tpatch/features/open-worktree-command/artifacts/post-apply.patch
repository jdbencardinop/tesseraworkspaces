index 0000000..54009fc
--- /dev/null
+++ b/internal/command_tmux.go
@@ -0,0 +1,176 @@
+package internal
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os/exec"
+	"path/filepath"
+	"strings"
+)
+
+// CommandTmuxRunner adds token verification to the existing transport. The
+// token is the existing launch/session owner, not a command history or schema.
+type CommandTmuxRunner interface {
+	SessionTmuxRunner
+	CommandSessionExists(name string) (bool, error)
+	NewCommandSession(name, dir string, command []string, token string) error
+	OwnedCommandSession(name, token string) (bool, error)
+	AttachCommandSession(name, token string) error
+	KillCommandSession(name, token string) error
+}
+
+func commandTmuxRunner(runner SessionTmuxRunner) (CommandTmuxRunner, error) {
+	tmux, ok := runner.(CommandTmuxRunner)
+	if !ok {
+		return nil, errors.New("tmux transport cannot verify command session ownership")
+	}
+	return tmux, nil
+}
+
+func RefuseCommandTmuxCollision(runner SessionTmuxRunner, name string) error {
+	tmux, err := commandTmuxRunner(runner)
+	if err != nil {
+		return err
+	}
+	present, err := tmux.CommandSessionExists(name)
+	if err != nil {
+		return err
+	}
+	if present {
+		return fmt.Errorf("tmux session %q already exists; close or inspect it first (the supplied command was not run)", name)
+	}
+	return nil
+}
+
+func (RealSessionTmuxRunner) CommandSessionExists(name string) (bool, error) {
+	if _, err := exec.LookPath("tmux"); err != nil {
+		return false, errors.New("tmux is unavailable; session state cannot be verified")
+	}
+	budget := NewStatusProbeBudget(context.Background())
+	defer budget.Close()
+	snapshot := (RealTmuxInventory{budget: budget}).Snapshot()
+	return snapshot.Sessions[name], snapshot.Err
+}
+
+func (r RealSessionTmuxRunner) NewCommandSession(name, dir string, command []string, token string) error {
+	if len(command) == 0 || !filepath.IsAbs(command[0]) || token == "" {
+		return errors.New("tmux command requires a bound absolute executable and an owner token")
+	}
+	// Multiple argv elements force tmux's exec route even for a zero-argument
+	// executable. Caller text appears only in positional args, never source.
+	// Only these option values are tmux formats. Do not format-escape the
+	// executable or child argv, which must reach exec byte-for-byte.
+	args := []string{"new-session", "-d", "-P", "-F", "#{session_id}",
+		"-s", strings.ReplaceAll(name, "#", "##"), "-c", strings.ReplaceAll(dir, "#", "##"),
+		"--", "/bin/sh", "-c", `exec "$@"`, "tws-command"}
+	args = append(args, command...)
+	// tmux parses trailing semicolons as command separators before exec.
+	// It removes exactly one backslash before a final semicolon, including
+	// when the value already contains backslashes. This is not shell quoting.
+	for i, arg := range args {
+		if strings.HasSuffix(arg, ";") {
+			args[i] = arg[:len(arg)-1] + `\;`
+		}
+	}
+	out, err := exec.Command("tmux", args...).Output()
+	if err != nil {
+		return fmt.Errorf("tmux command creation could not be confirmed: %w", err)
+	}
+	id := strings.TrimSpace(string(out))
+	if !validCommandTmuxID(id) {
+		return errors.New("tmux did not return a verifiable command session identity")
+	}
+	// Address the returned id, never a possibly reoccupied name. A command
+	// that already exited needs no marker; its checkout state predates spawn.
+	if err := exec.Command("tmux", "set-option", "-t", id, "@tws-command-owner", token).Run(); err != nil {
+		present, probeErr := r.CommandSessionExists(name)
+		if probeErr == nil && !present {
+			return nil
+		}
+		return errors.Join(errors.New("tmux command ownership could not be recorded; inspect the session"), err, probeErr)
+	}
+	return nil
+}
+
+func validCommandTmuxID(id string) bool {
+	if len(id) < 2 || id[0] != '$' {
+		return false
+	}
+	for _, c := range id[1:] {
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
+
+func (r RealSessionTmuxRunner) ownedCommandSessionID(name, token string) (string, error) {
+	present, err := r.CommandSessionExists(name)
+	if err != nil || !present {
+		return "", err
+	}
+	out, err := exec.Command("tmux", "display-message", "-p", "-t", "="+name+":",
+		"#{session_id}\t#{@tws-command-owner}").Output()
+	if err != nil {
+		if present, probeErr := r.CommandSessionExists(name); probeErr == nil && !present {
+			return "", nil
+		}
+		return "", fmt.Errorf("tmux command session identity is unverifiable: %w", err)
+	}
+	parts := strings.Split(strings.TrimSpace(string(out)), "\t")
+	if len(parts) != 2 || !validCommandTmuxID(parts[0]) || token == "" || parts[1] != token {
+		return "", errors.New("tmux command session ownership changed or is uncertain; inspect it without killing it")
+	}
+	return parts[0], nil
+}
+
+func (r RealSessionTmuxRunner) OwnedCommandSession(name, token string) (bool, error) {
+	id, err := r.ownedCommandSessionID(name, token)
+	return id != "", err
+}
+
+func (r RealSessionTmuxRunner) AttachCommandSession(name, token string) error {
+	id, err := r.ownedCommandSessionID(name, token)
+	if err != nil || id == "" {
+		return err
+	}
+	return r.AttachSession(id)
+}
+
+func (r RealSessionTmuxRunner) KillCommandSession(name, token string) error {
+	id, err := r.ownedCommandSessionID(name, token)
+	if err != nil || id == "" {
+		return err
+	}
+	return r.KillSession(id)
+}
+
+func RunExternalTmuxCommand(runner SessionTmuxRunner, name, path string, command []string, token string) error {
+	tmux, err := commandTmuxRunner(runner)
+	if err != nil {
+		return err
+	}
+	if err := RefuseCommandTmuxCollision(runner, name); err != nil {
+		return err
+	}
+	if err := tmux.NewCommandSession(name, path, command, token); err != nil {
+		return fmt.Errorf("command startup is uncertain; inspect tmux session %q before retrying (nothing was killed): %w", name, err)
+	}
+	present, err := tmux.OwnedCommandSession(name, token)
+	if err != nil || !present {
+		return err
+	}
+	attachErr := tmux.AttachCommandSession(name, token)
+	present, probeErr := tmux.OwnedCommandSession(name, token)
+	if probeErr != nil {
+		return errors.Join(attachErr, probeErr)
+	}
+	if attachErr != nil {
+		if present {
+			return fmt.Errorf("tmux attach failed; command session %q remains active: %w", name, attachErr)
+		}
+		return fmt.Errorf("tmux attach failed and the command session ended; its exit status is unavailable: %w", attachErr)
+	}
+	return nil
+}
diff --git a/internal/command_tmux_integration_test.go b/internal/command_tmux_integration_test.go
new file mode 100644
index 0000000..695d1c2
--- /dev/null
+++ b/internal/command_tmux_integration_test.go
@@ -0,0 +1,172 @@
+//go:build tmux_integration
+
+package internal
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+)
+
+type commandTmuxCapture struct {
+	Path       string   `json:"path"`
+	Executable string   `json:"executable"`
+	Args       []string `json:"args"`
+}
+
+// Intercept the isolated child before testing's flag parser, so even zero
+// arguments and option-like values reach the real executable unchanged.
+func init() {
+	if capture := os.Getenv("TWS_TEST_TMUX_ARGV_CAPTURE"); capture != "" {
+		path, err := os.Getwd()
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(2)
+		}
+		data, err := json.Marshal(commandTmuxCapture{
+			Path: path, Executable: os.Args[0], Args: append([]string{}, os.Args[1:]...),
+		})
+		if err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(2)
+		}
+		if err := os.WriteFile(capture, data, 0600); err != nil {
+			fmt.Fprintln(os.Stderr, err)
+			os.Exit(2)
+		}
+		time.Sleep(15 * time.Second)
+		os.Exit(0)
+	}
+}
+
+// Run with -tags=tmux_integration; this test requires the real optional tmux
+// binary and never substitutes a mock for its command parser.
+func TestCheckoutCommandTmuxLiteralTransport(t *testing.T) {
+	tmux, err := exec.LookPath("tmux")
+	if err != nil {
+		t.Fatal("tmux_integration requires tmux:", err)
+	}
+	tmux, err = filepath.Abs(tmux)
+	if err != nil {
+		t.Fatal(err)
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	edges := []string{"", ";", "literal;", ";;", "literal;;", "-;", "; ", "middle;value", "line\n;", "*", "not-a-tmux-command"}
+	for n := 1; n <= 6; n++ {
+		backslashes := strings.Repeat(`\`, n)
+		edges = append(edges, backslashes+";", "prefix"+backslashes+";", ";"+backslashes, backslashes+";middle")
+	}
+	for _, tc := range []struct {
+		name, session, directory string
+		args                     []string
+	}{
+		{"control", "literal-command;", `cwd\;`, []string{"literal", "ordinary"}},
+		{"zero", "literal-command;", `cwd\;`, []string{}},
+		{"semicolons-and-backslashes", "literal-command;", `cwd\;`, edges},
+		{"format-variables", "feat#{pid}", "cwd#{pid}", []string{"#{pid}", "#", "##"}},
+		{"format-jobs", "feat#(tws-format-job)", "cwd#(tws-format-job)", []string{"#(tws-format-job)", "#{pid}"}},
+		{"literal-hashes", "feat###hash##", "cwd####hash#", []string{"#", "##", "###", "####"}},
+		{"formats-and-semicolons", "feat##{pid}#(tws-format-job);", `cwd#{pid}#(tws-format-job)\;`, []string{"#(tws-format-job);", `\#{pid};`, "##;"}},
+		{"formats-zero", "feat#{pid}#(tws-format-job);", "cwd#{pid}#(tws-format-job);", []string{}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			root, err := filepath.EvalSymlinks(t.TempDir())
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Chdir(root)
+			bin := filepath.Join(root, "bin")
+			if err := os.Mkdir(bin, 0700); err != nil {
+				t.Fatal(err)
+			}
+			shim := "#!/bin/sh\nexec \"$TWS_TEST_REAL_TMUX\" -S \"$TWS_TEST_TMUX_SOCKET\" -f /dev/null \"$@\"\n"
+			if err := os.WriteFile(filepath.Join(bin, "tmux"), []byte(shim), 0700); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("PATH", bin+string(os.PathListSeparator)+os.Getenv("PATH"))
+			t.Setenv("TWS_TEST_REAL_TMUX", tmux)
+			t.Setenv("TWS_TEST_TMUX_SOCKET", "literal.sock")
+			home := filepath.Join(root, "home")
+			if err := os.Mkdir(home, 0700); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("HOME", home)
+			jobMarker := filepath.Join(root, "unexpected-format-job")
+			t.Setenv("TWS_TEST_FORMAT_JOB_MARKER", jobMarker)
+			if err := os.WriteFile(filepath.Join(bin, "tws-format-job"),
+				[]byte("#!/bin/sh\nprintf job > \"$TWS_TEST_FORMAT_JOB_MARKER\"\n"), 0700); err != nil {
+				t.Fatal(err)
+			}
+			capture := filepath.Join(root, "capture.json")
+			t.Setenv("TWS_TEST_TMUX_ARGV_CAPTURE", capture)
+			program := filepath.Join(root, "editor#{pid}#(tws-format-job) ' "+`\;`)
+			if err := os.Symlink(executable, program); err != nil {
+				t.Fatal(err)
+			}
+			dir := filepath.Join(root, tc.directory)
+			if err := os.Mkdir(dir, 0700); err != nil {
+				t.Fatal(err)
+			}
+			command := append([]string{program}, tc.args...)
+			runner := RealSessionTmuxRunner{}
+			name := tc.session
+			const token = "literal-command-test-owner"
+			if err := runner.NewCommandSession(name, dir, command, token); err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() {
+				if err := runner.KillCommandSession(name, token); err != nil {
+					t.Error(err)
+				}
+			})
+			if present, err := runner.OwnedCommandSession(name, token); err != nil || !present {
+				t.Fatalf("command session ownership: present=%t err=%v", present, err)
+			}
+			names, err := exec.Command("tmux", "list-sessions", "-F", "#{session_name}").Output()
+			if err != nil || string(names) != name+"\n" {
+				t.Fatalf("tmux changed the selected name: %q %v", names, err)
+			}
+			var got commandTmuxCapture
+			deadline := time.Now().Add(5 * time.Second)
+			for {
+				data, err := os.ReadFile(capture)
+				if err == nil && json.Unmarshal(data, &got) == nil {
+					break
+				}
+				if time.Now().After(deadline) {
+					t.Fatalf("child did not capture literal argv: %v", err)
+				}
+				time.Sleep(10 * time.Millisecond)
+			}
+			want := commandTmuxCapture{Path: dir, Executable: program, Args: tc.args}
+			if !reflect.DeepEqual(got, want) {
+				t.Fatalf("tmux changed literal values:\n got: %#v\nwant: %#v", got, want)
+			}
+			// Format jobs are asynchronous; inspect after the command is
+			// live as well as after ownership-verified cleanup.
+			time.Sleep(100 * time.Millisecond)
+			if _, err := os.Lstat(jobMarker); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("a selected name/directory or child argv launched a format job: %v", err)
+			}
+			if err := runner.KillCommandSession(name, token); err != nil {
+				t.Fatal(err)
+			}
+			if present, err := runner.OwnedCommandSession(name, token); err != nil || present {
+				t.Fatalf("owned cleanup failed: present=%t err=%v", present, err)
+			}
+			if _, err := os.Lstat(jobMarker); !errors.Is(err, os.ErrNotExist) {
+				t.Fatalf("format job marker appeared during cleanup: %v", err)
+			}
+		})
+	}
+}
