+// assertExactlyOnePlanGuardMarker asserts stderr carries exactly one line of
+// the form "plan-guard: <kind>: <detail>" (spec.md §6.4).
+func assertExactlyOnePlanGuardMarker(t *testing.T, stderr string) {
+	t.Helper()
