+func mustFormat(t *testing.T, plan RebasePlan) string {
+	t.Helper()
+	out, err := FormatRebasePlan(plan)
+	if err != nil {
+		t.Fatalf("FormatRebasePlan: %v", err)
+	}
+	return string(out)
+}
