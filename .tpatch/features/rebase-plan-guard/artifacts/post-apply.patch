+// `intent.validation` projection.
+func TestSyncGuardedState_Criterion22_24f_ValidationFreezeIsAuthoritative(t *testing.T) {
+	t.Run("checkout_transaction_resumes_with_the_persisted_command", func(t *testing.T) {
