+		cutoff := entry["cutoff"].(map[string]any)
+		if got := cutoff["recorded_sha"]; got != bSHA {
+			t.Fatalf("cutoff.recorded_sha = %v, want old cutoff B (%s)", got, bSHA)
+		}
