+
+// ============================================================================
+// PlanGuardBlock, PlanGuardLimit, PlanGuardEvaluation (§4.6)
+// ============================================================================
+
+// PlanGuardBlock is RebasePlan.Guard (7 members).
+type PlanGuardBlock struct {
+	Limits                     PlanGuardLimitSet        `json:"limits"`
