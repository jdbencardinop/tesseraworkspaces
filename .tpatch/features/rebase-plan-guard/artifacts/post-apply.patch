+func TestRebasePlanState_ClassifierValueReusedSkipsRedundantDecode(t *testing.T) {
+	t.Run("legacy", func(t *testing.T) {
+		fp := t.TempDir()
+		writeArtefact(t, SyncStatePath(fp), "pending: [oops\n\t- broken\n")
