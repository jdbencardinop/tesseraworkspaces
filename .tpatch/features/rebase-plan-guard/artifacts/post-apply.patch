+		if strings.HasPrefix(line, "plan-guard: ") {
+			count++
+		}
+	}
+	if count != 1 {
+		t.Fatalf("expected exactly one plan-guard marker line, found %d in stderr:\n%s", count, stderr)
+	}
+}
