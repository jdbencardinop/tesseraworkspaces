+	var executed []string
+	for _, r := range w.records(t) {
+		if r.Verb != "rebase" {
+			continue
+		}
+		tail := r.Tail()
+		for i, tok := range tail {
+			if tok == "--onto" && i+1 < len(tail) && len(tail) == len(planned) {
+				executed = tail
+			}
+		}
+	}
+	if executed == nil {
+		t.Fatal("guarded run issued no --onto rebase to compare")
+	}
+	assertMatchedRebaseArgv(t, 0, planned, executed)
+}
