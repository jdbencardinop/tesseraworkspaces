+		result := DeriveRepositoryConfig(inv, "", RepositoryConfigScope{Rebase: true}, "ctx", nil, "rebase")
+		if len(result.Issues) != 0 {
+			t.Fatalf("Issues = %+v, want none", result.Issues)
+		}
+	})
