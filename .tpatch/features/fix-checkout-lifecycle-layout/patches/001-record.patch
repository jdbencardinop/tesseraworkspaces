+func TestValidateFeatureName(t *testing.T) {
+	cases := []struct {
+		name    string
+		wantErr bool
+	}{
+		{"valid-feature", false},
+		{"my.feat", false},
+		{"", true},
+		{"..", true},
+		{"../evil", true},
+		{"a/b", true},
+		{"features", true},
+		{"state", true},
+		{".hidden", true},
+	}
+	for _, tc := range cases {
+		err := validateFeatureName(tc.name)
+		if (err != nil) != tc.wantErr {
+			t.Errorf("validateFeatureName(%q): err=%v, wantErr=%v", tc.name, err, tc.wantErr)
+		}
+	}
