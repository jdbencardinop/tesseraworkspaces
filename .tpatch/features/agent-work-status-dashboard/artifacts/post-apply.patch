+func assertKeys(t *testing.T, label string, node map[string]any, want []string) {
+	t.Helper()
+	var got []string
+	for k := range node {
+		got = append(got, k)
+	}
+	sort.Strings(got)
+	sorted := append([]string{}, want...)
+	sort.Strings(sorted)
+	if strings.Join(got, ",") != strings.Join(sorted, ",") {
+		t.Fatalf("%s keys = %v, want %v", label, got, sorted)
+	}
+}
