+	if pid <= 0 {
+		return ProcessDead
+	}
+	p, err := os.FindProcess(pid)
+	if err != nil {
+		return ProcessDead
+	}
+	err = p.Signal(syscall.Signal(0))
+	switch {
+	case err == nil:
