+		{[]RuntimePresence{PresenceStale, PresenceAbsent}, PresenceStale},
+		{[]RuntimePresence{PresenceStale, PresenceUnknown}, PresenceUnknown},
+		{[]RuntimePresence{PresenceStale, PresenceUnknown, PresencePresent}, PresencePresent},
+	}
+	for i, c := range cases {
