+
+func (f *cellFixture) shas(t *testing.T) map[string]string {
+	t.Helper()
+	out := make(map[string]string, 3)
+	for _, name := range []string{"root", "parent", "child"} {
+		out[name] = gitOutput(t, f.repo, "rev-parse", "refs/heads/"+name)
+	}
+	return out
