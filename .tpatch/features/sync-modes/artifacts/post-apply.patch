+func TestSyncModes_TriggerSet(t *testing.T) {
+	cases := []struct {
+		args    []string
+		newMode bool
+	}{
+		{nil, false},
+		{[]string{"--push"}, false},
+		{[]string{"-v"}, false},
+		{[]string{"--continue"}, false},
+		{[]string{"--abort"}, false},
+		{[]string{"--test", "go test ./..."}, false},
+		{[]string{"--fetch"}, true},
+		{[]string{"--no-fetch"}, true},
+		{[]string{"--full"}, true},
+		{[]string{"--local-only"}, true},
+		{[]string{"--only", "child"}, true},
+		{[]string{"--from", "parent"}, true},
