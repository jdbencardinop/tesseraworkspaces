+func TestSyncModes_I7BeforeI8(t *testing.T) {
+	cmd := parseSyncFlags(t, "--continue", "--abort", "--only", "a")
+	_, _, _, err := resolveSyncPolicy(cmd, internal.ModeExternal)
+	if err == nil {
+		t.Fatal("expected a refusal")
