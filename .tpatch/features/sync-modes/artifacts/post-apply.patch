+func TestSyncModes_HelpFlagBlockIsAlphabetical(t *testing.T) {
+	cmd := syncCmd()
+	usage := cmd.LocalFlags().FlagUsages()
+	var names []string
+	re := regexp.MustCompile(`--([a-z-]+)`)
+	for _, line := range strings.Split(usage, "\n") {
