+		projected = &SyncState{
+			StartedAt:    st.Payload.StartedAt,
+			FailedBranch: failed,
+			Pending:      append([]string{}, st.Payload.Pending...),
+			Completed:    append([]string{}, st.Payload.Completed...),
+			Skipped:      []string{},
+		}
