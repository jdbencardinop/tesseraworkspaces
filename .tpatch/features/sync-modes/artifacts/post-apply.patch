+	want := []string{"abort", "continue", "fetch", "from", "full", "local-only", "no-fetch", "only", "push", "test", "verbose"}
+	if strings.Join(names, ",") != strings.Join(want, ",") {
+		t.Fatalf("help flag block = %v, want %v", names, want)
