@@ -0,0 +1,567 @@
+package internal
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+// ScopedPushRepository is a physical Git binding, not a worktree requirement.
+// The spelling is retained so replacing an alias cannot redirect recovery.
+type ScopedPushRepository struct {
+	Directory ScopedPushDirectory `json:"directory"`
+	Common    ScopedPushDirectory `json:"common"`
+}
+
+func scopedPushCommand(dir string, args ...string) (*exec.Cmd, error) {
+	for _, key := range []string{
+		"GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE",
+		"GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_NAMESPACE",
+	} {
+		if os.Getenv(key) != "" {
+			return nil, fmt.Errorf("scoped push cannot prove repository identity with %s set", key)
+		}
+	}
+	cmd := exec.Command("git", append([]string{"--no-optional-locks", "--no-lazy-fetch", "--no-replace-objects", "-C", dir}, args...)...)
+	cmd.Env = append(os.Environ(), "GIT_NO_LAZY_FETCH=1", "GIT_NO_REPLACE_OBJECTS=1", "GIT_OPTIONAL_LOCKS=0")
+	return cmd, nil
+}
+
+// Git's stderr can contain authenticated URLs, including on local config
+// failures. Only the operation and exit status cross this boundary.
+func scopedPushGit(dir string, args ...string) ([]byte, error) {
+	cmd, err := scopedPushCommand(dir, args...)
+	if err != nil {
+		return nil, err
+	}
+	out, err := cmd.Output()
+	if err != nil {
+		var exit *exec.ExitError
+		if errors.As(err, &exit) {
+			if exit.ExitCode() == 129 {
+				return nil, fmt.Errorf("scoped push requires Git 2.45 or newer with --no-lazy-fetch support: %w", exit)
+			}
+			return nil, fmt.Errorf("scoped push Git operation failed (exit %d): %w", exit.ExitCode(), exit)
+		}
+		return nil, errors.New("scoped push could not start Git")
+	}
+	return out, nil
+}
+
+func scopedPushExit(err error, code int) bool {
+	var exit *exec.ExitError
+	return errors.As(err, &exit) && exit.ExitCode() == code
+}
+
+func ScopedPushRepositoryAt(path string) (ScopedPushRepository, error) {
+	dir, err := scopedPushDirectoryAt(path)
+	if err != nil {
+		return ScopedPushRepository{}, err
+	}
+	out, err := scopedPushGit(dir.Path, "rev-parse", "--path-format=absolute", "--git-common-dir", "--show-toplevel")
+	if err != nil {
+		// Bare repositories have no worktree root. A non-bare administrative
+		// directory is not a supported publication execution context.
+		bare, bareErr := scopedPushGit(dir.Path, "rev-parse", "--path-format=absolute", "--is-bare-repository", "--git-common-dir")
+		parts := strings.Split(strings.TrimSuffix(string(bare), "\n"), "\n")
+		if bareErr != nil || len(parts) != 2 || parts[0] != "true" {
+			return ScopedPushRepository{}, fmt.Errorf("cannot verify selected repository root at %s: %w", dir.Path, err)
+		}
+		out = []byte(parts[1] + "\n" + parts[1] + "\n")
+	}
+	parts := strings.Split(strings.TrimSuffix(string(out), "\n"), "\n")
+	if len(parts) != 2 {
+		return ScopedPushRepository{}, errors.New("Git returned an ambiguous repository root")
+	}
+	commonPath, executionPath := parts[0], parts[1]
+	if !filepath.IsAbs(commonPath) || !filepath.IsAbs(executionPath) || strings.ContainsAny(commonPath+executionPath, "\r\n\x00") {
+		return ScopedPushRepository{}, errors.New("Git returned an invalid repository root")
+	}
+	execution, err := scopedPushDirectoryAt(executionPath)
+	if err != nil {
+		return ScopedPushRepository{}, err
+	}
+	if execution.Path != dir.Path || execution.Identity != dir.Identity {
+		return ScopedPushRepository{}, fmt.Errorf("selected repository %s is a subdirectory; scoped push requires the working-tree or bare repository root", dir.Spelling)
+	}
+	common, err := scopedPushDirectoryAt(commonPath)
+	if err != nil {
+		return ScopedPushRepository{}, err
+	}
+	return ScopedPushRepository{Directory: dir, Common: common}, nil
+}
+
+func (repo ScopedPushRepository) verify() error {
+	if err := errors.Join(repo.Directory.verify(), repo.Common.verify()); err != nil {
+		return err
+	}
+	current, err := ScopedPushRepositoryAt(repo.Directory.Spelling)
+	if err != nil {
+		return err
+	}
+	if !current.Directory.sameBinding(repo.Directory) || !current.Common.sameBinding(repo.Common) {
+		return errors.New("scoped push repository/common-directory binding changed")
+	}
+	return nil
+}
+
+func scopedPushValidRef(ref string) bool {
+	if !strings.HasPrefix(ref, "refs/") || strings.HasSuffix(ref, "/") ||
+		strings.HasSuffix(ref, ".") || strings.Contains(ref, "..") ||
+		strings.Contains(ref, "@{") || strings.ContainsAny(ref, " ~^:?*[\\\x7f") {
+		return false
+	}
+	for _, c := range ref {
+		if c < 0x20 {
+			return false
+		}
+	}
+	for _, part := range strings.Split(ref, "/") {
+		if part == "" || strings.HasPrefix(part, ".") || strings.HasSuffix(part, ".lock") {
+			return false
+		}
+	}
+	return true
+}
+
+func scopedPushRef(dir, ref string) (string, error) {
+	if !scopedPushValidRef(ref) {
+		return "", fmt.Errorf("invalid full publication ref %q", ref)
+	}
+	if _, err := scopedPushGit(dir, "symbolic-ref", "-q", ref); err == nil {
+		return "", fmt.Errorf("symbolic publication ref %s is unsupported", ref)
+	} else if !scopedPushExit(err, 1) {
+		return "", err
+	}
+	out, err := scopedPushGit(dir, "show-ref", "--verify", "--hash", ref)
+	if scopedPushExit(err, 1) {
+		return "", nil
+	}
+	if err != nil {
+		// show-ref uses 128 for an absent exact ref on older Git versions.
+		out, probeErr := scopedPushGit(dir, "for-each-ref", "--format=%(refname)%09%(objectname)", ref)
+		if probeErr != nil || len(out) != 0 {
+			return "", err
+		}
+		return "", nil
+	}
+	oid := strings.TrimSpace(string(out))
+	if !validReparentRemoteOID(oid) {
+		return "", errors.New("Git returned an invalid object ID")
+	}
+	return oid, nil
+}
+
+func scopedPushCommit(dir, oid string) error {
+	if !validReparentRemoteOID(oid) {
+		return errors.New("publication requires a full commit object ID")
+	}
+	out, err := scopedPushGit(dir, "cat-file", "-t", oid)
+	if err != nil || strings.TrimSpace(string(out)) != "commit" {
+		return errors.New("publication commit is unavailable locally (lazy fetching is disabled)")
+	}
+	return nil
+}
+
+func scopedPushAncestor(dir, ancestor, tip string) (bool, error) {
+	if err := errors.Join(scopedPushCommit(dir, ancestor), scopedPushCommit(dir, tip)); err != nil {
+		return false, err
+	}
+	_, err := scopedPushGit(dir, "merge-base", "--is-ancestor", ancestor, tip)
+	if scopedPushExit(err, 1) {
+		return false, nil
+	}
+	return err == nil, err
+}
+
+type scopedPushEndpoint struct {
+	URL         string
+	Fingerprint string
+	TrackingRef string
+}
+
+func scopedPushConfigValues(dir, key string) ([]string, error) {
+	out, err := scopedPushGit(dir, "config", "--null", "--get-all", key)
+	if scopedPushExit(err, 1) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return strings.Split(strings.TrimSuffix(string(out), "\x00"), "\x00"), nil
+}
+
+func scopedPushEndpointURL(dir string, push bool) (string, error) {
+	args := []string{"remote", "get-url"}
+	if push {
+		args = append(args, "--push")
+	}
+	out, err := scopedPushGit(dir, append(args, "--all", "origin")...)
+	if err != nil {
+		return "", errors.New("selected repository has no usable origin endpoint")
+	}
+	raw := strings.TrimSuffix(string(out), "\n")
+	if raw == "" || strings.ContainsAny(raw, "\r\n\x00") {
+		return "", errors.New("origin must have exactly one unambiguous endpoint")
+	}
+	if strings.HasPrefix(raw, "-") || strings.Contains(raw, "::") {
+		return "", errors.New("unsupported origin endpoint")
+	}
+	// Directory is proved to be Git's execution root, not merely a directory
+	// inside a repository. Only that root may anchor a relative origin URL.
+	if !strings.Contains(raw, "://") && !strings.Contains(raw, ":") {
+		path, err := scopedPushLocalEndpointPath(dir, raw)
+		if err != nil {
+			return "", err
+		}
+		raw = path
+	}
+	return raw, nil
+}
+
+func scopedPushResolveEndpoint(dir, destination string) (scopedPushEndpoint, error) {
+	push, err := scopedPushEndpointURL(dir, true)
+	if err != nil {
+		return scopedPushEndpoint{}, err
+	}
+	fetch, err := scopedPushEndpointURL(dir, false)
+	if err != nil {
+		return scopedPushEndpoint{}, err
+	}
+	if push != fetch {
+		return scopedPushEndpoint{}, errors.New("distinct origin fetch/push endpoints cannot prove tracking authority")
+	}
+	if err := scopedPushCheckLiteralEndpoint(dir, push); err != nil {
+		return scopedPushEndpoint{}, err
+	}
+	mappings, err := scopedPushConfigValues(dir, "remote.origin.fetch")
+	if err != nil {
+		return scopedPushEndpoint{}, err
+	}
+	var tracking string
+	for _, mapping := range mappings {
+		source, target, ok := strings.Cut(strings.TrimPrefix(mapping, "+"), ":")
+		if !ok || strings.HasPrefix(source, "^") {
+			return scopedPushEndpoint{}, errors.New("unsupported origin tracking mapping")
+		}
+		match := source == destination
+		if strings.Contains(source, "*") || strings.Contains(target, "*") {
+			if source != "refs/heads/*" || target != "refs/remotes/origin/*" {
+				return scopedPushEndpoint{}, errors.New("unsupported origin wildcard tracking mapping")
+			}
+			target = "refs/remotes/origin/" + strings.TrimPrefix(destination, "refs/heads/")
+			match = true
+		}
+		if !match {
+			continue
+		}
+		if tracking != "" || !strings.HasPrefix(target, "refs/remotes/origin/") || !scopedPushValidRef(target) {
+			return scopedPushEndpoint{}, errors.New("ambiguous origin tracking mapping")
+		}
+		tracking = target
+	}
+	if tracking == "" {
+		return scopedPushEndpoint{}, errors.New("no supported origin tracking mapping for selected destination")
+	}
+	sum := sha256.Sum256([]byte("tws-push-endpoint-v1\x00" + push + "\x00" + tracking + "\x00" + strings.Join(mappings, "\x00")))
+	return scopedPushEndpoint{URL: push, TrackingRef: tracking, Fingerprint: hex.EncodeToString(sum[:])}, nil
+}
+
+func scopedPushLocalEndpointPath(dir, raw string) (string, error) {
+	path := raw
+	if !filepath.IsAbs(path) {
+		path = dir + string(filepath.Separator) + path
+	}
+	parts := strings.Split(path, string(filepath.Separator))
+	lastParent := -1
+	for i, part := range parts {
+		if part == ".." {
+			lastParent = i
+		}
+	}
+	current := string(filepath.Separator)
+	for i, part := range parts {
+		if i > lastParent {
+			break
+		}
+		switch part {
+		case "", ".":
+			continue
+		case "..":
+			current = filepath.Dir(current)
+		default:
+			current = filepath.Join(current, part)
+			info, err := os.Lstat(current)
+			if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+				return "", errors.New("local origin has an unverifiable or symlink-dependent parent traversal; use an unambiguous endpoint")
+			}
+		}
+	}
+	return filepath.Clean(path), nil
+}
+
+func scopedPushCheckLiteralEndpoint(dir, endpoint string) error {
+	// Ask Git to parse the complete key: its variable component is
+	// case-insensitive, unlike a remote-name subsection or a regexp match.
+	groups, err := scopedPushConfigValues(dir, "remotes."+endpoint)
+	if err != nil {
+		return err
+	}
+	if len(groups) != 0 {
+		return errors.New("resolved origin endpoint is also a configured remote group; refusing ambiguous transport")
+	}
+	_, err = scopedPushGit(dir, "config", "--null", "--get-regexp", `^remote\.`+regexp.QuoteMeta(endpoint)+`\.`)
+	if err == nil {
+		return errors.New("resolved origin endpoint is also a configured remote name; refusing ambiguous transport")
+	}
+	if !scopedPushExit(err, 1) {
+		return err
+	}
+	return scopedPushCheckEndpointRewrites(dir, endpoint)
+}
+
+// get-url expands a named remote once. Sending that resolved URL to push or
+// ls-remote would expand it AGAIN. Refuse any non-identity rule applicable to
+// the pinned endpoint instead of silently publishing to a different server.
+func scopedPushCheckEndpointRewrites(dir, endpoint string) error {
+	out, err := scopedPushGit(dir, "config", "--null", "--get-regexp", `^url\..*\.(insteadof|pushinsteadof)$`)
+	if scopedPushExit(err, 1) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	for _, item := range strings.Split(strings.TrimSuffix(string(out), "\x00"), "\x00") {
+		key, prefix, ok := strings.Cut(item, "\n")
+		if !ok || !strings.HasPrefix(key, "url.") {
+			return errors.New("unverifiable origin URL rewrite configuration")
+		}
+		replacement := strings.TrimPrefix(key, "url.")
+		if !strings.HasSuffix(replacement, ".insteadof") && !strings.HasSuffix(replacement, ".pushinsteadof") {
+			return errors.New("unsupported origin URL rewrite configuration")
+		}
+		if value, ok := strings.CutSuffix(replacement, ".pushinsteadof"); ok {
+			replacement = value
+		} else {
+			replacement = strings.TrimSuffix(replacement, ".insteadof")
+		}
+		if strings.HasPrefix(endpoint, prefix) && replacement+strings.TrimPrefix(endpoint, prefix) != endpoint {
+			return errors.New("origin endpoint would be rewritten again; use an unambiguous origin endpoint configuration")
+		}
+	}
+	return nil
+}
+
+type ScopedPushReflogTip struct {
+	OID  string `json:"oid"`
+	Time int64  `json:"time"`
+}
+
+type ScopedPushInclusion struct {
+	TrackingTime int64                 `json:"tracking_time"`
+	Tips         []ScopedPushReflogTip `json:"tips"`
+	Witness      string                `json:"witness"`
+}
+
+func scopedPushReflog(dir, ref string) ([]ScopedPushReflogTip, error) {
+	out, err := scopedPushGit(dir, "reflog", "show", "--date=unix", "--format=%H%x09%gD", ref)
+	if err != nil {
+		return nil, err
+	}
+	var tips []ScopedPushReflogTip
+	for _, line := range strings.Split(strings.TrimSpace(string(out)), "\n") {
+		oid, selector, ok := strings.Cut(line, "\t")
+		i := strings.LastIndex(selector, "@{")
+		if !ok || !validReparentRemoteOID(oid) || i < 0 || !strings.HasSuffix(selector, "}") {
+			return nil, errors.New("inclusion requires a readable local reflog")
+		}
+		stamp, err := strconv.ParseInt(selector[i+2:len(selector)-1], 10, 64)
+		if err != nil || stamp <= 0 {
+			return nil, errors.New("inclusion reflog has an invalid timestamp")
+		}
+		tips = append(tips, ScopedPushReflogTip{OID: oid, Time: stamp})
+	}
+	return tips, nil
+}
+
+// An explicit expected-OID lease disables Git's --force-if-includes. This
+// independent witness uses the same bounded range of branch reflog NEW tips:
+// newest through the first tip older than the latest tracking-ref timestamp.
+// No older history grants authority, and missing evidence always refuses.
+func scopedPushProveInclusion(dir, branchRef, trackingRef, expected, source string) (*ScopedPushInclusion, error) {
+	if expected == "" {
+		return nil, errors.New("reparent inclusion requires existing tracking evidence")
+	}
+	tracking, err := scopedPushReflog(dir, trackingRef)
+	if err != nil || len(tracking) == 0 || tracking[0].OID != expected {
+		return nil, errors.New("reparent inclusion requires the current tracking reflog tip")
+	}
+	branch, err := scopedPushReflog(dir, branchRef)
+	if err != nil || len(branch) == 0 || branch[0].OID != source {
+		return nil, errors.New("reparent inclusion requires the current branch reflog tip")
+	}
+	proof := &ScopedPushInclusion{TrackingTime: tracking[0].Time}
+	for _, tip := range branch {
+		proof.Tips = append(proof.Tips, tip)
+		contains, err := scopedPushAncestor(dir, expected, tip.OID)
+		if err != nil {
+			return nil, err
+		}
+		if contains && proof.Witness == "" {
+			proof.Witness = tip.OID
+		}
+		if tip.Time < proof.TrackingTime {
+			break
+		}
+	}
+	if proof.Witness == "" {
+		return nil, errors.New("reparent inclusion refused: no qualifying branch reflog tip includes the frozen remote-tracking tip; integrate remote work before starting a new push")
+	}
+	return proof, nil
+}
+
+func scopedPushPublish(dir, endpoint string, entry ScopedPushEntry) error {
+	if err := scopedPushCheckLiteralEndpoint(dir, endpoint); err != nil {
+		return err
+	}
+	args := []string{
+		"-c", "push.followTags=false", "-c", "push.recurseSubmodules=no",
+		"-c", "push.autoSetupRemote=false", "-c", "remote.origin.mirror=false",
+		"push", "--porcelain", "--no-mirror", "--no-all", "--no-tags",
+		"--no-follow-tags", "--no-prune", "--recurse-submodules=no",
+		"--force-with-lease=" + entry.Destination + ":" + entry.Expected,
+		"--", endpoint, entry.Source + ":" + entry.Destination,
+	}
+	cmd, err := scopedPushCommand(dir, args...)
+	if err != nil {
+		return err
+	}
+	var output bytes.Buffer
+	cmd.Stdout, cmd.Stderr, cmd.Stdin = &output, &output, os.Stdin
+	if err := cmd.Run(); err != nil {
+		return errors.New("Git push failed; remote effect is uncertain")
+	}
+	return nil
+}
+
+func scopedPushRemoteValue(dir, endpoint, ref string) (string, error) {
+	if err := scopedPushCheckLiteralEndpoint(dir, endpoint); err != nil {
+		return "", err
+	}
+	out, err := scopedPushGit(dir, "ls-remote", "--refs", "--exit-code", "--", endpoint, ref)
+	if scopedPushExit(err, 2) {
+		return "", nil
+	}
+	if err != nil {
+		return "", errors.New("cannot reconcile the recorded remote destination")
+	}
+	fields := strings.Fields(string(out))
+	if len(fields) != 2 || fields[1] != ref || !validReparentRemoteOID(fields[0]) {
+		return "", errors.New("remote returned ambiguous destination evidence")
+	}
+	return fields[0], nil
+}
+
+func scopedPushRefDirectories(repo ScopedPushRepository, ref string) error {
+	path := repo.Common.Path
+	for _, part := range strings.Split(filepath.Dir(ref), "/") {
+		path = filepath.Join(path, part)
+		info, err := os.Lstat(path)
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return errors.New("publication private-ref namespace contains a non-directory or symlink")
+		}
+	}
+	return nil
+}
+
+func scopedPushSyncRegular(path string) error {
+	snapshot, err := scopedPushReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return err
+	}
+	file := os.NewFile(uintptr(fd), path)
+	info, err := file.Stat()
+	if err != nil || !os.SameFile(info, snapshot.info) {
+		return errors.Join(err, file.Close(), errors.New("publication evidence changed before durability barrier"))
+	}
+	if err := errors.Join(file.Sync(), file.Close()); err != nil {
+		return err
+	}
+	return snapshot.verify(path)
+}
+
+// Repeat reference-storage barriers after uncertain local ref effects too.
+// Git's expected-value update remains the only writer of reference contents.
+func scopedPushSyncRefStorage(repo ScopedPushRepository, pin ScopedPushPin) error {
+	if err := errors.Join(repo.verify(), scopedPushRefDirectories(repo, pin.Ref)); err != nil {
+		return err
+	}
+	if err := errors.Join(
+		scopedPushSyncRegular(filepath.Join(repo.Common.Path, pin.Ref)),
+		scopedPushSyncRegular(filepath.Join(repo.Common.Path, "packed-refs")),
+	); err != nil {
+		return err
+	}
+	tables := filepath.Join(repo.Common.Path, "reftable")
+	if info, err := os.Lstat(tables); err == nil {
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return errors.New("unverifiable reftable directory")
+		}
+		entries, err := os.ReadDir(tables)
+		if err != nil {
+			return err
+		}
+		for _, entry := range entries {
+			if strings.HasSuffix(entry.Name(), ".lock") {
+				return errors.New("Git reference storage is busy; preserve publication state and retry")
+			}
+			if err := scopedPushSyncRegular(filepath.Join(tables, entry.Name())); err != nil {
+				return err
+			}
+		}
+		if err := syncDir(tables); err != nil {
+			return err
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if err := scopedPushCheckpoint("before-private-ref-directory-sync", pin.Entry); err != nil {
+		return err
+	}
+	for path := filepath.Join(repo.Common.Path, filepath.Dir(pin.Ref)); ; path = filepath.Dir(path) {
+		if _, err := os.Lstat(path); err == nil {
+			if err := syncDir(path); err != nil {
+				return err
+			}
+		} else if !errors.Is(err, os.ErrNotExist) {
+			return err
+		}
+		if path == repo.Common.Path {
+			break
+		}
+	}
+	return repo.verify()
+}
diff --git a/internal/scoped_push_guard.go b/internal/scoped_push_guard.go
new file mode 100644
index 0000000..0d97b25
--- /dev/null
+++ b/internal/scoped_push_guard.go
@@ -0,0 +1,114 @@
+package internal
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"gopkg.in/yaml.v3"
+)
+
+func externalScopedPushLocation(featurePath string) ScopedPushLocation {
+	return ScopedPushLocation{
+		Mode: ModeExternal, Feature: filepath.Base(featurePath), FeaturePath: featurePath,
+		MetadataRoot: filepath.Dir(featurePath),
+	}
+}
+
+func acquireScopedPushGuard(loc ScopedPushLocation, token string, recovery bool) (func() error, func() error, error) {
+	if loc.Mode == ModeCheckout {
+		stateDir := filepath.Join(loc.MetadataRoot, "state")
+		acquire := AcquireCheckoutMutationLock
+		if recovery {
+			acquire = ReclaimCheckoutMutationLock
+		}
+		if _, err := acquire(stateDir, token, loc.Feature, "publication", ScopedPushStatePath(loc)); err != nil {
+			return nil, nil, err
+		}
+		return scopedPushOwnedGuard(CheckoutMutationLockPath(stateDir))
+	}
+	path := SyncRunGuardPath(loc.FeaturePath)
+	if recovery {
+		snapshot, err := scopedPushReadFile(path)
+		if err != nil && !errors.Is(err, os.ErrNotExist) {
+			return nil, nil, err
+		}
+		if snapshot.info != nil {
+			var guard SyncRunGuard
+			if err := yaml.Unmarshal(snapshot.data, &guard); err != nil {
+				return nil, nil, err
+			}
+			if guard.Token != token || guard.PID <= 0 ||
+				(guard.PID != os.Getpid() && syncProcessAlive(guard.PID)) {
+				return nil, nil, errors.New("publication guard is foreign or held by a live process")
+			}
+			if err := snapshot.verify(path); err != nil {
+				return nil, nil, err
+			}
+			if err := os.Remove(path); err != nil {
+				return nil, nil, err
+			}
+		}
+		if err := writeSyncGuardExclusive(path, token); err != nil {
+			return nil, nil, err
+		}
+	} else if err := ClaimSyncRunGuard(loc.FeaturePath, token); err != nil {
+		return nil, nil, err
+	}
+	return scopedPushOwnedGuard(path)
+}
+
+func scopedPushOwnedGuard(path string) (func() error, func() error, error) {
+	snapshot, err := scopedPushReadFile(path)
+	if err != nil {
+		return nil, nil, err
+	}
+	verify := func() error { return snapshot.verify(path) }
+	release := func() error {
+		if err := scopedPushCheckpoint("before-release-guard", 0); err != nil {
+			return err
+		}
+		if err := verify(); err != nil {
+			return err
+		}
+		if err := os.Remove(path); err != nil {
+			return err
+		}
+		if err := scopedPushCheckpoint("after-release-guard", 0); err != nil {
+			return err
+		}
+		return syncDir(filepath.Dir(path))
+	}
+	return verify, release, nil
+}
+
+// RefuseCheckoutPublication is a local-only admission check for legacy
+// checkout metadata mutators that do not construct a sync transaction.
+func RefuseCheckoutPublication(ws Workspace) error {
+	if ws.Mode != ModeCheckout {
+		return nil
+	}
+	entries, err := os.ReadDir(ws.CheckoutStateDir())
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	for _, entry := range entries {
+		name := entry.Name()
+		if filepath.Ext(name) != ".json" || len(name) < len("-push.v1.json") ||
+			name[len(name)-len("-push.v1.json"):] != "-push.v1.json" {
+			continue
+		}
+		state, err := loadScopedPushStatePath(filepath.Join(ws.CheckoutStateDir(), name))
+		if err != nil {
+			return fmt.Errorf("untrusted checkout publication state: %w", err)
+		}
+		if state != nil && !state.Terminal() {
+			return fmt.Errorf("checkout publication is pending for %s; use tws push %s --continue or --cancel", state.Plan.Feature, state.Plan.Feature)
+		}
+	}
+	return nil
+}
diff --git a/internal/scoped_push_lifecycle.go b/internal/scoped_push_lifecycle.go
new file mode 100644
index 0000000..9acc0ef
--- /dev/null
+++ b/internal/scoped_push_lifecycle.go
@@ -0,0 +1,313 @@
+package internal
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// CheckoutMetadataReservation uses the existing workspace-wide mutation lock,
+// but describes its real metadata purpose, not a sync transaction.
+type CheckoutMetadataReservation struct {
+	root           ScopedPushDirectory
+	directory      ScopedPushDirectory
+	statePath      string
+	guard          scopedPushFile
+	moves          *checkoutMetadataMoves
+	moveSnapshot   scopedPushFile
+	movesCommitted bool
+}
+
+func checkoutMetadataOwnerPath(stateDir, token string) string {
+	if physical, err := filepath.EvalSymlinks(stateDir); err == nil {
+		stateDir = physical
+	}
+	return filepath.Join(stateDir, ".checkout-metadata-"+token)
+}
+
+func AcquireCheckoutMetadataReservation(ws Workspace, feature string) (*CheckoutMetadataReservation, error) {
+	if ws.Mode != ModeCheckout {
+		return nil, errors.New("checkout metadata reservation requires checkout mode")
+	}
+	if err := validateFeatureName(feature); err != nil {
+		return nil, err
+	}
+	root, err := scopedPushDirectoryAt(ws.MetadataRoot)
+	if err != nil {
+		return nil, err
+	}
+	stateDir := filepath.Join(root.Path, "state")
+	if info, err := os.Lstat(stateDir); err == nil {
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return nil, errors.New("checkout metadata requires a physical state directory")
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	token, err := managedOperationID()
+	if err != nil {
+		return nil, err
+	}
+	owner := checkoutMetadataOwnerPath(stateDir, token)
+	if _, err := AcquireCheckoutMutationLock(stateDir, token, feature, "metadata", owner); err != nil {
+		return nil, err
+	}
+	directory, err := scopedPushDirectoryAt(stateDir)
+	if err != nil || directory.Path != stateDir {
+		return nil, errors.Join(err, errors.New("checkout state directory changed during reservation; guard retained"))
+	}
+	guard, err := scopedPushReadFile(CheckoutMutationLockPath(stateDir))
+	if err != nil {
+		return nil, err
+	}
+	reservation := &CheckoutMetadataReservation{root: root, directory: directory, statePath: owner, guard: guard}
+	if err := reservation.Verify(); err != nil {
+		return nil, errors.Join(err, reservation.Release())
+	}
+	return reservation, nil
+}
+
+func (r *CheckoutMetadataReservation) Verify() error {
+	if r == nil || r.guard.info == nil {
+		return errors.New("checkout metadata mutation requires a held reservation")
+	}
+	if err := errors.Join(r.root.verify(), r.directory.verify(),
+		r.guard.verify(CheckoutMutationLockPath(r.directory.Path))); err != nil {
+		return err
+	}
+	return verifyCheckoutMutationReservation(r.directory.Path, r.statePath, nil, []string{r.statePath})
+}
+
+func (r *CheckoutMetadataReservation) Release() error {
+	if r == nil || r.guard.info == nil {
+		return nil
+	}
+	if err := r.finishMoves(); err != nil {
+		return err
+	}
+	path := CheckoutMutationLockPath(r.directory.Path)
+	if err := errors.Join(r.root.verify(), r.directory.verify(), r.guard.verify(path)); err != nil {
+		return err
+	}
+	if err := os.Remove(path); err != nil {
+		return err
+	}
+	r.guard = scopedPushFile{}
+	return syncDir(r.directory.Path)
+}
+
+func (r *CheckoutMetadataReservation) RefusePublicationDestination(feature string) error {
+	if err := r.Verify(); err != nil {
+		return err
+	}
+	if err := validateFeatureName(feature); err != nil {
+		return err
+	}
+	path := filepath.Join(r.directory.Path, feature+"-push.v1.json")
+	if _, err := os.Lstat(path); err == nil {
+		return errors.New("destination name has publication evidence; refusing to overwrite or adopt it")
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	return nil
+}
+
+// Retirement preserves exact terminal bytes/inode in immutable owned history.
+// History is durable BEFORE unlinking the reusable live name. A crash may leave
+// two links to the same owned inode, never a need to trust a copied receipt.
+func (r *CheckoutMetadataReservation) RetirePublicationReceipt(feature, featurePath string) error {
+	snapshot, state, err := r.terminalPublicationSnapshot(feature, featurePath)
+	if err != nil {
+		return err
+	}
+	if state == nil {
+		return syncDir(r.directory.Path)
+	}
+	path := filepath.Join(r.directory.Path, feature+"-push.v1.json")
+	return r.retirePublicationSnapshot(path, snapshot, state)
+}
+
+func (r *CheckoutMetadataReservation) ValidatePublicationReceipt(feature, featurePath string) error {
+	_, _, err := r.terminalPublicationSnapshot(feature, featurePath)
+	return err
+}
+
+func (r *CheckoutMetadataReservation) terminalPublicationSnapshot(feature, featurePath string) (scopedPushFile, *ScopedPushState, error) {
+	if err := r.Verify(); err != nil {
+		return scopedPushFile{}, nil, err
+	}
+	if err := validateFeatureName(feature); err != nil {
+		return scopedPushFile{}, nil, err
+	}
+	loc := ScopedPushLocation{Mode: ModeCheckout, Feature: feature, FeaturePath: featurePath, MetadataRoot: r.root.Path}
+	path := ScopedPushStatePath(loc)
+	snapshot, err := scopedPushReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return scopedPushFile{}, nil, nil
+	}
+	if err != nil {
+		return scopedPushFile{}, nil, err
+	}
+	state, err := scopedPushDecode(snapshot.data)
+	if err != nil {
+		return scopedPushFile{}, nil, err
+	}
+	if !state.Terminal() {
+		return scopedPushFile{}, nil, errors.New("pending publication cannot be retired by a metadata operation")
+	}
+	featureDir, err := scopedPushDirectoryAt(featurePath)
+	if err != nil {
+		return scopedPushFile{}, nil, err
+	}
+	loc.FeaturePath = featureDir.Path
+	journal := scopedPushJournal{path: path, snapshot: snapshot, state: state}
+	if err := journal.verifyLocation(loc); err != nil {
+		return scopedPushFile{}, nil, fmt.Errorf("refusing to retire foreign publication history: %w", err)
+	}
+	if snapshot.info.Mode().Perm() != 0o600 {
+		return scopedPushFile{}, nil, errors.New("terminal publication receipt permissions changed")
+	}
+	return snapshot, state, nil
+}
+
+func (r *CheckoutMetadataReservation) retirePublicationSnapshot(path string, snapshot scopedPushFile, state *ScopedPushState) error {
+	historyPath := filepath.Join(r.directory.Path, "publication-history")
+	if err := os.Mkdir(historyPath, 0o700); err != nil && !errors.Is(err, os.ErrExist) {
+		return err
+	}
+	info, err := os.Lstat(historyPath)
+	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return errors.Join(err, errors.New("publication history must be a physical directory"))
+	}
+	historyDir, err := scopedPushDirectoryAt(historyPath)
+	if err != nil {
+		return err
+	}
+	target := filepath.Join(historyPath, state.Plan.Token+".json")
+	if err := scopedPushCheckpoint("before-terminal-receipt-link", 0); err != nil {
+		return err
+	}
+	if err := errors.Join(r.Verify(), snapshot.verify(path), historyDir.verify()); err != nil {
+		return err
+	}
+	if err := os.Link(path, target); err != nil && !errors.Is(err, os.ErrExist) {
+		return err
+	}
+	history, err := scopedPushReadFile(target)
+	if err != nil {
+		return err
+	}
+	if !os.SameFile(snapshot.info, history.info) || !bytes.Equal(snapshot.data, history.data) {
+		return errors.New("publication history destination is foreign; evidence retained")
+	}
+	if err := scopedPushCheckpoint("after-terminal-receipt-link", 0); err != nil {
+		return err
+	}
+	if err := scopedPushSyncSnapshot(target, history, historyDir, r.root, state.Revision); err != nil {
+		return err
+	}
+	if err := scopedPushCheckpoint("before-terminal-receipt-remove", 0); err != nil {
+		return err
+	}
+	if err := errors.Join(r.Verify(), snapshot.verify(path), history.verify(target), historyDir.verify()); err != nil {
+		return err
+	}
+	if err := os.Remove(path); err != nil {
+		return err
+	}
+	if err := scopedPushCheckpoint("after-terminal-receipt-remove", 0); err != nil {
+		return err
+	}
+	return errors.Join(syncDir(r.directory.Path), r.Verify(), history.verify(target))
+}
+
+func (r *CheckoutMetadataReservation) EnsureFeatureParent() error {
+	if err := r.Verify(); err != nil {
+		return err
+	}
+	path := filepath.Join(r.root.Path, "features")
+	if err := os.Mkdir(path, 0o755); err != nil && !errors.Is(err, os.ErrExist) {
+		return err
+	}
+	info, err := os.Lstat(path)
+	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+		return errors.Join(err, errors.New("checkout features must use a physical directory"))
+	}
+	return syncDir(r.root.Path)
+}
+
+func (r *CheckoutMetadataReservation) MoveFeature(from, to string, identity managedObjectIdentity) (bool, error) {
+	if err := scopedPushCheckpoint("before-checkout-feature-move", 0); err != nil {
+		return false, err
+	}
+	if err := r.Verify(); err != nil {
+		return false, err
+	}
+	source, err := r.relativeFeaturePath(from)
+	if err != nil {
+		return false, errors.New("checkout feature source is outside the reserved workspace")
+	}
+	target, err := r.relativeFeaturePath(to)
+	if err != nil {
+		return false, errors.New("checkout feature destination is outside the reserved workspace")
+	}
+	if err := managedVerifyPathIdentity(from, identity); err != nil {
+		return false, err
+	}
+	if err := r.beginMove(source, target, identity); err != nil {
+		return false, err
+	}
+	root, err := os.OpenRoot(r.root.Path)
+	if err != nil {
+		return false, err
+	}
+	defer root.Close() //nolint:errcheck
+	moveErr := managedRenameNoReplaceWith(root, source, target, func() error {
+		return scopedPushCheckpoint("after-checkout-feature-rename-before-sync", len(r.moves.Moves)-1)
+	})
+	move := r.moves.Moves[len(r.moves.Moves)-1]
+	_, moved, locationErr := r.moveLocation(move)
+	if moveErr != nil {
+		// Visibility is not durability. Repeat the barriers under the same
+		// reservation, but preserve the original failure for the caller.
+		return moved, errors.Join(moveErr, locationErr, r.syncMoveParents(move))
+	}
+	if !moved {
+		return false, errors.Join(locationErr, errors.New("checkout feature did not remain at its intended destination"))
+	}
+	return moved, locationErr
+}
+
+func (r *CheckoutMetadataReservation) RemoveFeature(path string, identity managedObjectIdentity) error {
+	if err := scopedPushCheckpoint("before-checkout-feature-remove", 0); err != nil {
+		return err
+	}
+	if err := errors.Join(r.Verify(), managedVerifyPathIdentity(path, identity)); err != nil {
+		return err
+	}
+	relative, err := r.relativeFeaturePath(path)
+	if err != nil {
+		return err
+	}
+	root, err := os.OpenRoot(r.root.Path)
+	if err != nil {
+		return err
+	}
+	defer root.Close() //nolint:errcheck
+	if err := root.RemoveAll(relative); err != nil {
+		return err
+	}
+	return syncDir(filepath.Dir(path))
+}
+
+func (r *CheckoutMetadataReservation) relativeFeaturePath(path string) (string, error) {
+	for _, root := range []string{r.root.Path, r.root.Spelling} {
+		relative, err := filepath.Rel(root, path)
+		if err == nil && filepath.IsLocal(relative) && relative != "." {
+			return relative, nil
+		}
+	}
+	return "", errors.New("path is not within the reserved checkout workspace")
+}
diff --git a/internal/scoped_push_state.go b/internal/scoped_push_state.go
new file mode 100644
index 0000000..1af4c83
--- /dev/null
+++ b/internal/scoped_push_state.go
@@ -0,0 +1,684 @@
+package internal
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"golang.org/x/sys/unix"
+	"gopkg.in/yaml.v3"
+)
+
+const ScopedPushStateVersion = 1
+const scopedPushStateKind = "tws-scoped-publication"
+
+// ScopedPushCheckpoint is a test-only fault/process-loss seam. Production
+// cannot enable it with a flag, configuration setting, or environment variable.
+var ScopedPushCheckpoint func(step string, index int) error
+
+func scopedPushCheckpoint(step string, index int) error {
+	if ScopedPushCheckpoint != nil {
+		return ScopedPushCheckpoint(step, index)
+	}
+	return nil
+}
+
+type ScopedPushDirectory struct {
+	Path     string                  `json:"path"`
+	Spelling string                  `json:"spelling"`
+	Identity managedObjectIdentity   `json:"identity"`
+	Alias    *featureRenameRootAlias `json:"alias,omitempty"`
+}
+
+func scopedPushDirectoryAt(path string) (ScopedPushDirectory, error) {
+	spelling, err := filepath.Abs(path)
+	if err != nil {
+		return ScopedPushDirectory{}, err
+	}
+	directory, alias, err := resolveFeatureRenameRoot(spelling)
+	if err != nil {
+		return ScopedPushDirectory{}, err
+	}
+	return ScopedPushDirectory{Path: directory.Path, Spelling: spelling, Identity: directory.Identity, Alias: alias}, nil
+}
+
+func (d ScopedPushDirectory) valid() bool {
+	if !filepath.IsAbs(d.Path) || filepath.Clean(d.Path) != d.Path ||
+		!filepath.IsAbs(d.Spelling) || filepath.Clean(d.Spelling) != d.Spelling ||
+		d.Identity.Inode == 0 {
+		return false
+	}
+	if d.Alias != nil {
+		if d.Alias.Spelling != d.Spelling || d.Alias.Directory.Path != d.Path ||
+			d.Alias.Directory.Identity != d.Identity || len(d.Alias.Links) == 0 {
+			return false
+		}
+		for _, link := range d.Alias.Links {
+			if !filepath.IsAbs(link.Path) || !filepath.IsAbs(link.Resolved) || link.Target == "" || link.Identity.Inode == 0 {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func (d ScopedPushDirectory) sameBinding(other ScopedPushDirectory) bool {
+	return d.Path == other.Path && d.Spelling == other.Spelling && d.Identity == other.Identity
+}
+
+func (d ScopedPushDirectory) verify() error {
+	if err := d.Alias.verify(); err != nil {
+		return err
+	}
+	got, err := scopedPushDirectoryAt(d.Spelling)
+	if err != nil {
+		return err
+	}
+	if !got.sameBinding(d) || (got.Alias == nil) != (d.Alias == nil) {
+		return fmt.Errorf("scoped push directory identity changed at %s", d.Spelling)
+	}
+	return nil
+}
+
+type ScopedPushLocation struct {
+	Mode          WorkspaceMode
+	Feature       string
+	FeaturePath   string
+	MetadataRoot  string
+	SelectionRoot string
+}
+
+func (loc ScopedPushLocation) ReparentLocation() ReparentLocation {
+	return ReparentLocation{
+		Mode: loc.Mode, Feature: loc.Feature, FeaturePath: loc.FeaturePath,
+		CheckoutStateDir: filepath.Join(loc.MetadataRoot, "state"),
+	}
+}
+
+func ScopedPushStatePath(loc ScopedPushLocation) string {
+	if loc.Mode == ModeCheckout {
+		return filepath.Join(loc.MetadataRoot, "state", loc.Feature+"-push.v1.json")
+	}
+	return filepath.Join(loc.FeaturePath, ".push-state.v1.json")
+}
+
+func LoadScopedPushStack(featurePath string) (Stack, error) {
+	file, err := scopedPushReadFile(StackPath(featurePath))
+	if err != nil {
+		return Stack{}, err
+	}
+	var stack Stack
+	if err := yaml.Unmarshal(file.data, &stack); err != nil {
+		return Stack{}, err
+	}
+	return stack, nil
+}
+
+type ScopedPushEntry struct {
+	Name        string               `json:"name"`
+	GitBranch   string               `json:"git_branch"`
+	RepoToken   string               `json:"repo_token"`
+	Base        string               `json:"base"`
+	Archived    bool                 `json:"archived"`
+	Repository  ScopedPushRepository `json:"repository"`
+	Source      string               `json:"source"`
+	Destination string               `json:"destination"`
+	TrackingRef string               `json:"tracking_ref"`
+	Expected    string               `json:"expected"`
+	Endpoint    string               `json:"endpoint_fingerprint"`
+	Inclusion   *ScopedPushInclusion `json:"inclusion,omitempty"`
+	Followup    *ReparentRemoteEntry `json:"reparent_followup,omitempty"`
+}
+
+type ScopedPushPin struct {
+	Entry int    `json:"entry"`
+	Kind  string `json:"kind"`
+	Ref   string `json:"ref"`
+	OID   string `json:"oid"`
+}
+
+type ScopedPushPlan struct {
+	Token          string               `json:"token"`
+	Created        string               `json:"created"`
+	Mode           WorkspaceMode        `json:"mode"`
+	Feature        string               `json:"feature"`
+	Root           ScopedPushDirectory  `json:"root"`
+	FeatureDir     ScopedPushDirectory  `json:"feature_directory"`
+	SelectionRoot  string               `json:"selection_root"`
+	Selection      *ScopedPushDirectory `json:"selection_binding,omitempty"`
+	StateDirectory ScopedPushDirectory  `json:"state_directory"`
+	Scope          SyncScopeKind        `json:"scope"`
+	Selector       string               `json:"selector"`
+	Entries        []ScopedPushEntry    `json:"entries"`
+	Pins           []ScopedPushPin      `json:"pins"`
+}
+
+type ScopedPushState struct {
+	Kind              string            `json:"kind"`
+	Version           int               `json:"version"`
+	Revision          uint64            `json:"revision"`
+	Plan              ScopedPushPlan    `json:"plan"`
+	PlanHash          string            `json:"plan_hash"`
+	Phase             string            `json:"phase"`
+	Rows              []string          `json:"rows"`
+	Pins              []string          `json:"pins"`
+	FollowupDecisions map[string]string `json:"followup_decisions,omitempty"`
+}
+
+func (s *ScopedPushState) Terminal() bool {
+	return s != nil && (s.Phase == "completed" || s.Phase == "canceled")
+}
+
+func scopedPushPlanHash(plan ScopedPushPlan) string {
+	data, _ := json.Marshal(plan)
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+func scopedPushPinRef(token string, entry int, kind string) string {
+	return fmt.Sprintf("refs/tws/push/%s/%d/%s", token, entry, kind)
+}
+
+func (s *ScopedPushState) validate() error {
+	bad := func(detail string) error { return fmt.Errorf("invalid scoped push state: %s", detail) }
+	p := s.Plan
+	if s.Kind != scopedPushStateKind || s.Version != ScopedPushStateVersion {
+		return bad("unsupported kind/version")
+	}
+	if s.Revision == 0 || !markerIDRegexp.MatchString(p.Token) || s.PlanHash != scopedPushPlanHash(p) {
+		return bad("invalid token, revision, or frozen-plan digest")
+	}
+	if _, err := time.Parse(time.RFC3339, p.Created); err != nil {
+		return bad("invalid creation time")
+	}
+	if err := validateFeatureName(p.Feature); err != nil {
+		return bad("invalid feature")
+	}
+	if p.Mode != ModeExternal && p.Mode != ModeCheckout {
+		return bad("invalid workspace mode")
+	}
+	if !p.Root.valid() || !p.FeatureDir.valid() || !p.StateDirectory.valid() {
+		return bad("invalid physical directory binding")
+	}
+	if p.Mode == ModeExternal {
+		if p.FeatureDir.Path != filepath.Join(p.Root.Path, p.Feature) || p.StateDirectory.Path != p.FeatureDir.Path {
+			return bad("external state does not belong to the selected feature")
+		}
+	} else if (p.FeatureDir.Path != filepath.Join(p.Root.Path, "features", p.Feature) &&
+		p.FeatureDir.Path != filepath.Join(p.Root.Path, p.Feature)) ||
+		p.StateDirectory.Path != filepath.Join(p.Root.Path, "state") {
+		return bad("checkout state does not belong to the workspace")
+	}
+	if p.SelectionRoot != "" && (!filepath.IsAbs(p.SelectionRoot) || filepath.Clean(p.SelectionRoot) != p.SelectionRoot) {
+		return bad("invalid selected root")
+	}
+	if p.Selection != nil && (!p.Selection.valid() || p.Selection.Spelling != p.SelectionRoot) {
+		return bad("invalid selected-root binding")
+	}
+	if p.Scope != SyncScopeOne && p.Scope != SyncScopeSubtree || p.Selector == "" {
+		return bad("a standalone plan must have an explicit logical selection")
+	}
+	if len(p.Entries) == 0 || len(s.Rows) != len(p.Entries) || len(s.Pins) != len(p.Pins) {
+		return bad("incomplete ordered outcomes")
+	}
+	switch s.Phase {
+	case "preparing", "publishing", "cleaning", "canceling", "completed", "canceled":
+	default:
+		return bad("unknown phase")
+	}
+	names, branches := map[string]bool{}, map[string]bool{}
+	selector, unfinished := false, false
+	for i, entry := range p.Entries {
+		if _, err := ScopedPushWorktreePath(p.FeatureDir.Path, entry.Name); err != nil {
+			return bad("unsafe logical entry spelling")
+		}
+		if entry.Name == "" || strings.ContainsAny(entry.Name, "\x00\r\n") || names[entry.Name] ||
+			!scopedPushValidRef("refs/heads/"+entry.GitBranch) || branches[entry.GitBranch] {
+			return bad("invalid or duplicate logical/Git entry")
+		}
+		names[entry.Name], branches[entry.GitBranch] = true, true
+		if entry.Name == p.Selector {
+			selector = true
+			if entry.Archived {
+				return bad("the selector cannot be archived")
+			}
+		}
+		if p.Mode == ModeCheckout && entry.RepoToken != "" {
+			return bad("checkout publication is single-repository")
+		}
+		if entry.Archived {
+			if s.Rows[i] != "skipped" || entry.Source != "" || entry.Expected != "" || entry.Endpoint != "" || entry.Inclusion != nil || entry.Followup != nil {
+				return bad("archived entry has publication authority")
+			}
+			continue
+		}
+		if !entry.Repository.Directory.valid() || !entry.Repository.Common.valid() ||
+			!validReparentRemoteOID(entry.Source) || entry.Destination != "refs/heads/"+entry.GitBranch ||
+			!scopedPushValidRef(entry.TrackingRef) || !strings.HasPrefix(entry.TrackingRef, "refs/remotes/origin/") ||
+			len(entry.Endpoint) != 64 || !stackStatusObjectID.MatchString(entry.Endpoint) ||
+			(entry.Expected != "" && (!validReparentRemoteOID(entry.Expected) || len(entry.Expected) != len(entry.Source))) {
+			return bad("invalid source, destination, endpoint, repository, or lease")
+		}
+		if entry.Followup != nil {
+			if entry.Inclusion == nil {
+				return bad("published reparent follow-up lacks frozen inclusion authority")
+			}
+			followup := ReparentRemoteRecord{
+				RecordVersion: ReparentRemoteRecordVersion, Feature: p.Feature,
+				RunID: p.Token, CreatedAt: p.Created, Entries: []ReparentRemoteEntry{*entry.Followup},
+			}
+			if err := validateReparentRemoteRecord(ReparentLocation{Feature: p.Feature}, followup); err != nil ||
+				entry.Followup.Name != entry.Name || entry.Followup.GitBranch != entry.GitBranch || entry.Followup.Repo != entry.RepoToken ||
+				len(entry.Followup.NewTipSHA) != len(entry.Source) || len(entry.Followup.RemoteSHAAtWrite) != len(entry.Source) {
+				return bad("invalid frozen reparent follow-up")
+			}
+		}
+		if proof := entry.Inclusion; proof != nil {
+			if entry.Followup == nil || entry.Expected == "" || proof.TrackingTime <= 0 ||
+				len(proof.Tips) == 0 || proof.Tips[0].OID != entry.Source || !validReparentRemoteOID(proof.Witness) ||
+				len(proof.Witness) != len(entry.Source) {
+				return bad("incomplete inclusion witness")
+			}
+			witness := false
+			for j, tip := range proof.Tips {
+				if !validReparentRemoteOID(tip.OID) || len(tip.OID) != len(entry.Source) ||
+					tip.Time <= 0 || (tip.Time < proof.TrackingTime && j != len(proof.Tips)-1) {
+					return bad("inclusion witness extends beyond the reflog cutoff")
+				}
+				witness = witness || tip.OID == proof.Witness
+			}
+			if !witness {
+				return bad("inclusion witness is outside its qualifying reflog range")
+			}
+		}
+		switch s.Rows[i] {
+		case "succeeded":
+			if unfinished || s.Phase == "preparing" {
+				return bad("success is out of publication order")
+			}
+		case "intent":
+			if unfinished || s.Phase == "preparing" {
+				return bad("intent is out of publication order")
+			}
+			unfinished = true
+		case "pending":
+			unfinished = true
+		default:
+			return bad("unknown publication outcome")
+		}
+	}
+	if !selector || (p.Scope == SyncScopeOne && len(p.Entries) != 1) ||
+		((s.Phase == "cleaning" || s.Phase == "completed") && unfinished) {
+		return bad("scope or terminal outcomes are inconsistent")
+	}
+	frozen := Stack{}
+	for _, entry := range p.Entries {
+		frozen.Branches = append(frozen.Branches, StackEntry{
+			Name: entry.Name, Branch: entry.GitBranch, Repo: entry.RepoToken,
+			Base: entry.Base, Archived: entry.Archived,
+		})
+	}
+	selection, err := ResolveSyncSelection(frozen, SyncRunPolicy{ScopeKind: p.Scope, Selector: p.Selector},
+		SyncSelectionOpts{Mode: p.Mode, NewMode: true, Feature: p.Feature})
+	if err != nil || len(selection.Entries) != len(p.Entries) {
+		return bad("frozen membership does not prove the recorded logical selection")
+	}
+	for i := range selection.Entries {
+		if selection.Entries[i].Name != p.Entries[i].Name {
+			return bad("frozen entries are not in dependency order")
+		}
+	}
+	wantPins := scopedPushPlanPins(p.Token, p.Entries)
+	legacyTerminal := false
+	if s.Terminal() && len(s.FollowupDecisions) == 0 && len(wantPins) != len(p.Pins) {
+		// Pre-release terminal receipts grant no publication authority. Keep
+		// their exact historical bytes readable for verified retirement.
+		var legacy []ScopedPushPin
+		for _, pin := range wantPins {
+			if pin.Kind != "followup" {
+				legacy = append(legacy, pin)
+			}
+		}
+		if len(legacy) == len(p.Pins) {
+			wantPins, legacyTerminal = legacy, true
+		}
+	}
+	if len(wantPins) != len(p.Pins) {
+		return bad("incomplete object protection")
+	}
+	cleanupStarted := s.Terminal()
+	for i, pin := range p.Pins {
+		if pin != wantPins[i] {
+			return bad("private ref is not owned by this plan")
+		}
+		switch s.Pins[i] {
+		case "pending", "creating":
+			if s.Phase != "preparing" && s.Phase != "canceling" {
+				return bad("object creation outside preparation")
+			}
+		case "held":
+			if s.Terminal() {
+				return bad("terminal receipt still owns a private ref")
+			}
+		case "deleting", "removed":
+			cleanupStarted = true
+			if s.Phase != "cleaning" && s.Phase != "canceling" && !s.Terminal() {
+				return bad("object cleanup before publication")
+			}
+			if s.Terminal() && s.Pins[i] != "removed" {
+				return bad("terminal cleanup is incomplete")
+			}
+		default:
+			return bad("unknown object-protection outcome")
+		}
+	}
+	followupNames := map[string]int{}
+	for i, entry := range p.Entries {
+		if entry.Followup != nil {
+			followupNames[entry.Name] = i
+			if cleanupStarted && !legacyTerminal && s.FollowupDecisions[entry.Name] == "" {
+				return bad("object cleanup requires a durable follow-up decision")
+			}
+		}
+	}
+	for name, decision := range s.FollowupDecisions {
+		index, ok := followupNames[name]
+		if !ok || (decision != "keep" && decision != "clear") ||
+			(decision == "clear" && s.Rows[index] != "succeeded") ||
+			s.Phase == "preparing" || s.Phase == "publishing" {
+			return bad("invalid follow-up decision")
+		}
+	}
+	return nil
+}
+
+func scopedPushPlanPins(token string, entries []ScopedPushEntry) []ScopedPushPin {
+	var pins []ScopedPushPin
+	for i, e := range entries {
+		if e.Archived {
+			continue
+		}
+		add := func(kind, oid string) {
+			if oid != "" {
+				pins = append(pins, ScopedPushPin{Entry: i, Kind: kind, Ref: scopedPushPinRef(token, i, kind), OID: oid})
+			}
+		}
+		add("source", e.Source)
+		add("lease", e.Expected)
+		if e.Inclusion != nil {
+			add("witness", e.Inclusion.Witness)
+		}
+		if e.Followup != nil {
+			add("followup", e.Followup.NewTipSHA)
+		}
+	}
+	return pins
+}
+
+type scopedPushFile struct {
+	data []byte
+	info os.FileInfo
+}
+
+// Read without following symlinks or blocking on FIFOs, then verify the public
+// name still denotes the opened inode. Callers also bind the parent directory.
+func scopedPushReadFile(path string) (scopedPushFile, error) {
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return scopedPushFile{}, err
+	}
+	file := os.NewFile(uintptr(fd), path)
+	defer file.Close() //nolint:errcheck
+	info, err := file.Stat()
+	if err != nil {
+		return scopedPushFile{}, err
+	}
+	if !info.Mode().IsRegular() {
+		return scopedPushFile{}, fmt.Errorf("scoped push requires a regular file at %s", path)
+	}
+	data, err := io.ReadAll(io.LimitReader(file, 16<<20+1))
+	if err != nil || len(data) > 16<<20 {
+		return scopedPushFile{}, errors.Join(err, errors.New("publication evidence is unreadable or oversized"))
+	}
+	current, err := os.Lstat(path)
+	if err != nil || !os.SameFile(info, current) {
+		return scopedPushFile{}, errors.Join(err, errors.New("publication evidence changed while reading"))
+	}
+	return scopedPushFile{data: data, info: info}, nil
+}
+
+func (snapshot scopedPushFile) verify(path string) error {
+	current, err := scopedPushReadFile(path)
+	if snapshot.info == nil && errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if snapshot.info == nil || !os.SameFile(snapshot.info, current.info) || !bytes.Equal(snapshot.data, current.data) {
+		return errors.New("publication evidence was replaced or edited; refusing to overwrite it")
+	}
+	return nil
+}
+
+func scopedPushDecode(data []byte) (*ScopedPushState, error) {
+	// encoding/json's ordinary decoder accepts duplicate keys. Publication
+	// authority is stricter: no duplicate, unknown, or trailing fields.
+	if err := scopedPushJSONKeys(json.NewDecoder(bytes.NewReader(data))); err != nil {
+		return nil, err
+	}
+	var state ScopedPushState
+	d := json.NewDecoder(bytes.NewReader(data))
+	d.DisallowUnknownFields()
+	if err := d.Decode(&state); err != nil {
+		return nil, fmt.Errorf("untrusted scoped push state: %w", err)
+	}
+	if err := d.Decode(new(any)); err != io.EOF {
+		return nil, errors.New("trailing scoped push state")
+	}
+	if err := state.validate(); err != nil {
+		return nil, err
+	}
+	return &state, nil
+}
+
+func scopedPushJSONKeys(d *json.Decoder) error {
+	token, err := d.Token()
+	if err != nil {
+		return err
+	}
+	if token != json.Delim('{') && token != json.Delim('[') {
+		return nil
+	}
+	object := token == json.Delim('{')
+	keys := map[string]bool{}
+	for d.More() {
+		if object {
+			key, err := d.Token()
+			if err != nil {
+				return err
+			}
+			name, ok := key.(string)
+			if !ok || keys[name] {
+				return errors.New("duplicate/invalid key in scoped push state")
+			}
+			keys[name] = true
+		}
+		if err := scopedPushJSONKeys(d); err != nil {
+			return err
+		}
+	}
+	_, err = d.Token()
+	return err
+}
+
+func LoadScopedPushState(loc ScopedPushLocation) (*ScopedPushState, error) {
+	return loadScopedPushStatePath(ScopedPushStatePath(loc))
+}
+
+func loadScopedPushStatePath(path string) (*ScopedPushState, error) {
+	snapshot, err := scopedPushReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return scopedPushDecode(snapshot.data)
+}
+
+func RefusePendingScopedPush(loc ScopedPushLocation) error {
+	state, err := LoadScopedPushState(loc)
+	if err != nil {
+		return fmt.Errorf("scoped push evidence cannot be trusted; preserve %s: %w", ScopedPushStatePath(loc), err)
+	}
+	if state != nil && !state.Terminal() {
+		return fmt.Errorf("scoped push is pending for %q; run: tws push %s --continue (or --cancel); use the new tws binary while pending", loc.Feature, loc.Feature)
+	}
+	return nil
+}
+
+type scopedPushJournal struct {
+	path     string
+	snapshot scopedPushFile
+	state    *ScopedPushState
+	verify   func() error
+}
+
+func (j *scopedPushJournal) save() error {
+	j.state.Revision++
+	if err := j.state.validate(); err != nil {
+		return err
+	}
+	data, err := json.MarshalIndent(j.state, "", "  ")
+	if err != nil {
+		return err
+	}
+	data = append(data, '\n')
+	if len(data) > 16<<20 {
+		return errors.New("publication evidence exceeds the supported state size; existing journal preserved")
+	}
+	if err := scopedPushCheckpoint("before-state-write", int(j.state.Revision)); err != nil {
+		return err
+	}
+	if j.verify != nil {
+		if err := j.verify(); err != nil {
+			return err
+		}
+	}
+	if err := errors.Join(j.state.Plan.Root.verify(), j.state.Plan.FeatureDir.verify()); err != nil {
+		return err
+	}
+	parent := j.state.Plan.StateDirectory
+	if err := parent.verify(); err != nil {
+		return err
+	}
+	if err := j.snapshot.verify(j.path); err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(parent.Path, ".push-write-"+j.state.Plan.Token+"-")
+	if err != nil {
+		return err
+	}
+	name := file.Name()
+	info, err := file.Stat()
+	if err != nil {
+		return errors.Join(err, file.Close())
+	}
+	defer func() {
+		if current, err := os.Lstat(name); err == nil && os.SameFile(info, current) {
+			_ = os.Remove(name)
+		}
+	}()
+	if _, err := file.Write(data); err != nil {
+		return errors.Join(err, file.Close())
+	}
+	if err := scopedPushCheckpoint("before-state-file-sync", int(j.state.Revision)); err != nil {
+		return errors.Join(err, file.Close())
+	}
+	if err := errors.Join(file.Sync(), file.Close()); err != nil {
+		return err
+	}
+	if err := scopedPushCheckpoint("before-state-install", int(j.state.Revision)); err != nil {
+		return err
+	}
+	if err := errors.Join(parent.verify(), j.snapshot.verify(j.path)); err != nil {
+		return err
+	}
+	if j.snapshot.info == nil {
+		err = os.Link(name, j.path)
+	} else {
+		err = os.Rename(name, j.path)
+	}
+	if err != nil {
+		return err
+	}
+	j.snapshot, err = scopedPushReadFile(j.path)
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(j.snapshot.data, data) {
+		return errors.New("publication journal changed during installation")
+	}
+	if err := scopedPushCheckpoint("after-state-install", int(j.state.Revision)); err != nil {
+		return err
+	}
+	return j.sync()
+}
+
+// Repeated on recovery even for an already-visible success or terminal
+// receipt: rename visibility after a failed fsync is not durable completion.
+func (j *scopedPushJournal) sync() error {
+	if j.state.Terminal() && j.state.Plan.Mode == ModeExternal {
+		parent, err := scopedPushDirectoryAt(filepath.Dir(j.path))
+		if err != nil {
+			return err
+		}
+		if parent.Identity != j.state.Plan.FeatureDir.Identity {
+			return errors.New("terminal publication history feature identity changed")
+		}
+		return scopedPushSyncSnapshot(j.path, j.snapshot, parent, j.state.Plan.Root, j.state.Revision)
+	}
+	return scopedPushSyncSnapshot(j.path, j.snapshot, j.state.Plan.StateDirectory, j.state.Plan.Root, j.state.Revision)
+}
+
+func scopedPushSyncSnapshot(path string, snapshot scopedPushFile, parent, root ScopedPushDirectory, revision uint64) error {
+	if err := errors.Join(parent.verify(), root.verify(), snapshot.verify(path)); err != nil {
+		return err
+	}
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return err
+	}
+	file := os.NewFile(uintptr(fd), path)
+	info, err := file.Stat()
+	if err != nil || !os.SameFile(info, snapshot.info) {
+		return errors.Join(err, file.Close(), errors.New("publication journal changed before fsync"))
+	}
+	if err := errors.Join(file.Sync(), file.Close()); err != nil {
+		return err
+	}
+	if err := scopedPushCheckpoint("before-state-directory-sync", int(revision)); err != nil {
+		return err
+	}
+	for dir := filepath.Dir(path); ; dir = filepath.Dir(dir) {
+		if err := syncDir(dir); err != nil {
+			return err
+		}
+		if dir == root.Path {
+			break
+		}
+		if filepath.Dir(dir) == dir {
+			return errors.New("publication state directory is outside its root")
+		}
+	}
+	return errors.Join(parent.verify(), root.verify(), snapshot.verify(path))
+}
