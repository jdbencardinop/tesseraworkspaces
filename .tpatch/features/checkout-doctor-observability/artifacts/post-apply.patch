+	}
+	stack := internal.Stack{
+		Branches: []internal.StackEntry{
+			{Name: "feat-branch", Base: "main"},
+		},
+	}
+	if err := internal.SaveStack(fp, stack); err != nil {
+		t.Fatal(err)
+	}
+
+	err := runCheckoutList(ws)
+	if err != nil {
+		t.Fatalf("runCheckoutList failed: %v", err)
+	}
