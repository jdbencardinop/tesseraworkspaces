+				writeAndCommit(t, repo, "upstream.txt", "upstream\n", "upstream")
+				gitRun(t, repo, "push", "origin", "master")
+				transition := gitOutput(t, repo, "rev-parse", "refs/remotes/origin/master")
+				configuredDestination := root
