+		t.Fatal(err)
+	}
+	if err := renameTx.Release(); err != nil {
+		t.Fatal(err)
+	}
+
+	after := walkTree(t, parent)
+	if strings.Join(before, "\n") != strings.Join(after, "\n") {
+		t.Fatalf("no-op transactions created files:\nbefore=%v\nafter=%v", before, after)
+	}
+}
