+			}
+			_, _ = fmt.Fprintf(out, "Added:       %s\n", view.AddedAt.Format("2006-01-02 15:04:05"))
+			if view.UpdatedAt != nil {
+				_, _ = fmt.Fprintf(out, "Updated:     %s\n", view.UpdatedAt.Format("2006-01-02 15:04:05"))
+			}
