+func nestedSpaceFixture(t *testing.T, root string) (parent, kept string) {
+	t.Helper()
+	parent = mustMkdir(t, filepath.Join(root, "Learning"))
+	target := mustMkdir(t, filepath.Join(parent, "notes"))
+	kept = filepath.Join(target, "keep.md")
